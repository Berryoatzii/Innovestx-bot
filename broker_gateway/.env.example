# เริ่มจาก UAT/Sandbox เท่านั้น
BROKER_ENVIRONMENT=uat
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_APP_CODE=SANDBOX
SETTRADE_ACCOUNT_NO=
SETTRADE_PIN=

# สุ่มค่าใหม่ยาวอย่างน้อย 32 ตัวอักษร และห้ามส่งให้ใคร
BROKER_GATEWAY_TOKEN=
BROKER_GATEWAY_HOST=127.0.0.1
BROKER_GATEWAY_PORT=8787
BROKER_JOURNAL_PATH=broker-journal.sqlite3

# Sandbox pilot: จำกัดมูลค่าต่อคำสั่ง
BROKER_MAX_ORDER_VALUE=3000

# ต้องยืนยันชื่อ field จาก get_account_info ของบัญชี UAT ก่อนใช้
BROKER_CASH_FIELD=
BROKER_REQUIRED_ACCOUNT_TYPE=
BROKER_BOARD_LOT=100
# ระบุรายสัญลักษณ์เท่านั้น ห้ามใช้ wildcard เช่น DR ที่ยืนยันแล้ว: {"NVDA80":1}
BROKER_BOARD_LOT_OVERRIDES_JSON={}
BROKER_CASH_BUFFER_BPS=100

BROKER_CONNECT_TIMEOUT_SECONDS=5
BROKER_READ_TIMEOUT_SECONDS=15

# Production ถูกล็อกไว้โดยตั้งใจ ห้ามกรอกจนกว่า UAT test matrix ผ่าน
# โหมดนี้อนุญาตเฉพาะการอ่านบัญชีจริง และบล็อก POST ซื้อ/ขายทั้งหมด
BROKER_PRODUCTION_READ_ONLY=false
BROKER_PRODUCTION_ENABLED=false
BROKER_PRODUCTION_ACK=
BROKER_PRODUCTION_CONFIRMATION=
SETTRADE_BROKER_ID=
